---
/**
 * Page frame for every page: head metadata, self-hosted fonts, global styles,
 * skip link, header, main landmark and footer.
 */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_NAME } from '../lib/site';
import { assetHref } from '../lib/paths';

interface Props {
  /** Page title without the site name (omit on the home page). */
  title?: string;
  /** One or two sentences for search results and link previews. */
  description: string;
  /** Set on pages that must not be indexed (e.g. 404). */
  noindex?: boolean;
  /** Result pages use only their experiment evidence, including a static footer attribution. */
  evidenceOnly?: boolean;
}

const { title, description, noindex = false, evidenceOnly = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME}: deadline-based source routing for LEO constellations`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Everything the site needs is served from this site, so the browser is told to load nothing
// from anywhere else and to send nothing anywhere else. GitHub Pages cannot set headers, so the
// policy is a meta element; the dev server (live reload) runs without it.
const CSP = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob:",
  "font-src 'self'",
  "connect-src 'self'",
  "worker-src 'self' blob:",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
].join('; ');
---

<!doctype html>
<html lang="en-GB" dir="ltr">
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={CSP} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && !noindex && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070d18" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/svg+xml" href={assetHref('favicon.svg')} />
    <link rel="sitemap" href={assetHref('sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && !noindex && <meta property="og:url" content={canonical} />}
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter evidenceOnly={evidenceOnly} />
  </body>
</html>

<style>
  main {
    flex: 1 0 auto;
  }

  main:focus {
    outline: none;
  }
</style>
