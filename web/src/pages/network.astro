---
/**
 * /network: "Network simulation". One real ns-3 probe on the real 463 km Starlink shell,
 * replayed hop by hop: where it went, the deadline it carried at each hop, when it arrived,
 * and how its T-CRH bytes changed. The same probe from the paired no-fault run is shown
 * next to it. Data: results/network-walk/<run>/walk.json, verified against its manifest at
 * build time (lib/network/walk.ts). Works without JavaScript (map, table, bytes are static);
 * the script only adds the step-through animation.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LabelChip from '../components/LabelChip.astro';
import { loadWalk, decodeFlags } from '../lib/network/walk';
import { pageHref } from '../lib/paths';
import { REPO_URL } from '../lib/site';

const ev = await loadWalk();
const w = ev.walk;
const unitMs = w.unit_ns / 1e6;
const fmt = (v: number | null, d = 1) => (v === null ? '' : v.toFixed(d));
const lateIdx = w.fault_run.hops.findIndex((h) => h.node_id === w.fault_run.late_node);
const faultA = w.path.findIndex((p) => p.name === w.fault.names[0] || p.name === w.fault.names[1]);
const faultB = w.path.findIndex((p, i) => i > faultA && (p.name === w.fault.names[0] || p.name === w.fault.names[1]));

// Equirectangular drawing frame around the path (drawing aid only).
const lons = w.path.map((p) => p.lon);
const lats = w.path.map((p) => p.lat);
const pad = 6;
const lonMin = Math.min(...lons) - pad, lonMax = Math.max(...lons) + pad;
const latMin = Math.min(...lats) - pad, latMax = Math.max(...lats) + pad;
const W = 1000, H = Math.round((W * (latMax - latMin)) / (lonMax - lonMin));
const X = (lon: number) => ((lon - lonMin) / (lonMax - lonMin)) * W;
const Y = (lat: number) => ((latMax - lat) / (latMax - latMin)) * H;
const pts = w.path.map((p) => ({ ...p, x: X(p.lon), y: Y(p.lat) }));
const start = pts[0] ?? { x: 0, y: 0 };
const segA = pts[faultA];
const segB = pts[faultB];
const grid = {
  lon: Array.from({ length: 40 }, (_, i) => -90 + i * 10).filter((v) => v > lonMin && v < lonMax),
  lat: Array.from({ length: 19 }, (_, i) => -90 + i * 10).filter((v) => v > latMin && v < latMax),
};
const hexBytes = (hex: string | null) => (hex ? hex.match(/../g) ?? [] : []);
const fieldOf = (i: number) =>
  i < 4 ? ['nh', 'len', 'type', 'sl'][i] : i < 8 ? ['flags', 'hops', 'devhop', 'res'][i - 4] : i < 12 ? 'epoch' : 'entry';
// Entries end at 12 + 3 x Num Hops (byte 5); the bytes after that pad the header to a multiple of 8.
const entriesEnd = (bytes: string[]) => 12 + 3 * Number.parseInt(bytes[5] ?? '0', 16);
// Byte boundaries between the header's field groups, for spacing in the byte rows.
const groupStart = (i: number, bytes: string[]) => i === 4 || i === 8 || i === 12 || i === entriesEnd(bytes);
const lateHop = w.fault_run.hops[lateIdx];
const twinAtLate = w.nofault_run.hops[lateIdx];
const lateName = w.path[lateIdx]?.name ?? '';
const data = JSON.stringify({ w, lateIdx, faultA, faultB, pts: pts.map((p) => [p.x, p.y]), vw: W });
const det = w.detection;
const resultOf = (i: number, dev: boolean) =>
  i === 0 ? 'created' : i === lateIdx ? 'late' : dev ? 'dev' : 'ontime';
---

<BaseLayout
  title="Network simulation"
  description="One real ns-3 packet on the real Starlink 463 km shell, hop by hop: the deadline it carries, when it arrives, and how a slowed laser link makes it late."
>
  <header class="page-hero container">
    <p class="eyebrow">Network simulation</p>
    <h1>One packet, hop by hop</h1>
    <p class="lede">
      This page demonstrates ChronoRoute's improved packet transmission mechanism. Each packet carries
      its source route in a T-CRH (an IPv6 Routing Header, type 253) and, for every hop, the latest time
      it should arrive there. Below is a real probe from our ns-3 simulation on the real Starlink
      53.2&deg; / 463 km shell: {w.flow.src} to {w.flow.dst}, {w.path.length - 2} satellites. One laser
      link on its path was slowed from {w.fault.nominal_rate_bps / 1e9} Gb/s to {w.fault.rate_bps / 1000} kb/s
      while staying <strong>up</strong>, so a hello-based link-state protocol still sees it as healthy.
    </p>
    <p class="chips">
      <LabelChip kind="real" note="satellite positions (SGP4 on CelesTrak elements)" />
      <LabelChip kind="real" note="T-CRH header bytes" />
      <LabelChip kind="modelled" note="laser links, link rate, queues, the slowed link" />
    </p>
  </header>

  <section class="section section--flush sim-section" aria-labelledby="sim-title">
    <div class="container">
      <div class="panel sim">
        <div class="panel__bar">
          <h2 id="sim-title" class="panel__title">
            <span class="sim__led" aria-hidden="true"></span>
            Path of the probe: {w.flow.src} → {w.flow.dst}
          </h2>
          <dl class="sim__facts">
            <div><dt>Satellites</dt><dd class="num">{w.path.length - 2}</dd></div>
            <div><dt>Slowed link</dt><dd class="num">{w.fault.nominal_rate_bps / 1e9} Gb/s → {w.fault.rate_bps / 1000} kb/s</dd></div>
            <div><dt>Link state</dt><dd>{w.fault.link_state}</dd></div>
          </dl>
        </div>

        <div class="panel__body">
          <div class="controls" data-controls hidden>
            <div class="controls__buttons" role="group" aria-label="Replay">
              <button type="button" class="button button--sm button--primary" data-act="play">
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4.5 3v10l8-5-8-5Z" fill="currentColor"></path></svg>
                Play
              </button>
              <button type="button" class="button button--sm" data-act="step">
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 3.5v9l6.5-4.5-6.5-4.5Z" fill="currentColor"></path><path d="M12 3.5v9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
                Next hop
              </button>
              <button type="button" class="button button--sm" data-act="reset">
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 8a4.5 4.5 0 1 0 1.4-3.3M3.5 2.5v2.7h2.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                Reset
              </button>
            </div>
            <div class="seg" role="radiogroup" aria-label="Which run">
              <label><input type="radio" name="variant" value="fault" checked /> With the slowed link</label>
              <label><input type="radio" name="variant" value="nofault" /> Same packet, no fault</label>
            </div>
            <span class="status" data-status aria-live="polite"></span>
          </div>

          <figure class="map">
            <div class="map__frame" data-map-frame tabindex="0" role="region" aria-label="Map of the probe's path (scrolls sideways on small screens)">
              <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Path of the probe from ${w.flow.src} to ${w.flow.dst}`}>
                <rect x="0" y="0" width={W} height={H} class="map__bg" />
                {grid.lon.map((lon) => <line x1={X(lon)} x2={X(lon)} y1="0" y2={H} class="map__grid" />)}
                {grid.lat.map((lat) => <line x1="0" x2={W} y1={Y(lat)} y2={Y(lat)} class="map__grid" />)}
                {grid.lon.map((lon) => <text x={X(lon) + 4} y={H - 6} class="map__tick">{lon}&deg;</text>)}
                {grid.lat.map((lat) => <text x="4" y={Y(lat) - 4} class="map__tick">{lat}&deg;</text>)}
                <polyline points={pts.map((p) => `${p.x},${p.y}`).join(' ')} class="map__path-glow" />
                <polyline points={pts.map((p) => `${p.x},${p.y}`).join(' ')} class="map__path" />
                {segA && segB && (
                  <line x1={segA.x} y1={segA.y} x2={segB.x} y2={segB.y} class="map__slow">
                    <title>{`Slowed laser link: ${w.fault.names.join(' - ')} (still up)`}</title>
                  </line>
                )}
                {pts.map((p, i) => (
                  p.kind === 'gs'
                    ? <rect x={p.x - 9} y={p.y - 9} width="18" height="18" class="map__gs" data-node={i}><title>{p.name}</title></rect>
                    : <circle cx={p.x} cy={p.y} r="8" class:list={['map__sat', i === lateIdx && 'map__sat--late']} data-node={i}><title>{`${p.name} (SID ${p.sid})`}</title></circle>
                ))}
                {pts.map((p, i) => {
                  // ground stations: label below; points near the right edge: label to the left
                  const right = p.x > W - 220;
                  const x = p.kind === 'gs' ? p.x : right ? p.x - 12 : p.x + 12;
                  const y = p.kind === 'gs' ? p.y + 32 : p.y + (i % 2 ? 20 : -12);
                  return (
                    <text x={x} y={y} text-anchor={right ? 'end' : 'start'} class:list={['map__label', p.kind === 'gs' && 'map__label--gs']}>
                      {p.kind === 'gs' ? p.name : `${i}. ${p.name}`}
                    </text>
                  );
                })}
                <circle cx={start.x} cy={start.y} r="13" class="map__packet-halo" data-packet-halo />
                <circle cx={start.x} cy={start.y} r="7" class="map__packet" data-packet />
              </svg>
            </div>
            <ul class="map__legend" aria-label="Map key">
              <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3" y="3" width="10" height="10" class="key-gs"></rect></svg>Ground station</li>
              <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="5" class="key-sat"></circle></svg>Satellite</li>
              <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="5" class="key-late"></circle></svg>Hop where the probe was late</li>
              <li><svg viewBox="0 0 24 16" aria-hidden="true" focusable="false"><line x1="2" y1="8" x2="22" y2="8" class="key-slow"></line></svg>Slowed laser link (still up)</li>
              <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="4" class="key-packet"></circle></svg>The probe</li>
            </ul>
            <figcaption>
              Positions of the path's nodes at the send time, drawn on a latitude/longitude grid (a drawing aid;
              the simulation uses 3D positions). The orange segment is the slowed laser link
              ({w.fault.names.join(' to ')}).
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="hops-title">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Hop by hop</p>
        <h2 id="hops-title">What each node saw</h2>
        <p>
          At every hop the node reads the deadline for itself from the header (Epoch_Base plus the
          per-hop budgets) and compares it with its own clock (unit {unitMs} ms, GPS time). Arrival and
          deadline are shown in milliseconds after the packet entered the network.
        </p>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-labelledby="hops-title">
        <table class="hops">
          <thead>
            <tr>
              <th scope="col">Hop</th><th scope="col">Node</th><th scope="col">SID</th>
              <th scope="col" class="col-num">Segments Left</th><th scope="col" class="col-num">Deadline (ms)</th>
              <th scope="col" class="col-num">Arrival (ms)</th><th scope="col" class="col-num">Margin (ms)</th>
              <th scope="col" class="col-num">No-fault arrival (ms)</th><th scope="col">Result</th>
            </tr>
          </thead>
          <tbody>
            {w.path.map((p, i) => {
              // loadWalk refuses hop lists of a different length than the path
              const f = w.fault_run.hops[i]!;
              const n = w.nofault_run.hops[i]!;
              const dev = decodeFlags(f.flags).dev;
              const result = resultOf(i, dev);
              return (
                <tr data-row={i} class:list={[i === lateIdx && 'is-late']}>
                  <td class="mono">{i === 0 ? 'ingress' : i}</td>
                  <td>{p.name}</td>
                  <td class="mono">{`0x${p.sid.toString(16).toUpperCase().padStart(4, '0')}`}</td>
                  <td class="col-num">{f.sl}</td>
                  <td class="col-num">{fmt(f.deadline_ms)}</td>
                  <td class="col-num">{fmt(f.elapsed_ms)}</td>
                  <td class:list={['col-num', f.margin_ms !== null && f.margin_ms < 0 && 'is-negative']}>{fmt(f.margin_ms)}</td>
                  <td class="col-num">{fmt(n.elapsed_ms)}</td>
                  <td class="hops__result">
                    <span class:list={['result', `result--${result}`]}>
                      <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                        {result === 'created' && <rect x="2.5" y="2.5" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.4" />}
                        {result === 'ontime' && <path d="M2.5 6.3 5 8.6l4.5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />}
                        {result === 'late' && <path d="M6 1.5 11 10.5H1L6 1.5ZM6 5v2.4M6 8.9v.1" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />}
                        {result === 'dev' && <circle cx="6" cy="6" r="3" fill="currentColor" />}
                      </svg>
                      {i === 0 ? 'header created' : i === lateIdx ? `LATE: DEV set, Dev Hop ${i}` : dev ? 'DEV already set' : 'on time'}
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="prose hops__note">
        Hop {lateIdx} ({lateName}) is the far end of the slowed link: the probe
        arrived {lateHop ? fmt(-(lateHop.margin_ms ?? 0)) : ''} ms after its deadline there, so that node set
        the DEV flag and wrote its hop number into Dev Hop. The same probe in the paired run without the
        fault reached that node {twinAtLate && lateHop ? fmt((lateHop.deadline_ms ?? 0) - twinAtLate.elapsed_ms) : ''} ms
        before the deadline. The packet still reached {w.flow.dst} ({w.fault_run.outcome === 'deliver' ? 'delivered' : w.fault_run.outcome}),
        because this run uses the <em>continue</em> policy: it records the miss and keeps the planned path.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="bytes-title">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">On the wire</p>
        <h2 id="bytes-title">The header bytes, as they arrived</h2>
        <p>
          Only three bytes change in flight: <strong>Segments Left</strong> (counts down at every hop),
          <strong>Flags</strong> (the DEV bit 0x01 is set at the late hop) and <strong>Dev Hop</strong>.
          Everything else, including Epoch_Base and the per-hop budgets, is fixed at the ingress.
        </p>
      </div>
      <div class="panel bytes-panel">
        <div class="bytes" data-bytes>
          {w.fault_run.hops.map((h, i) => {
            const bytes = hexBytes(h.hex);
            const prev = i > 0 ? hexBytes(w.fault_run.hops[i - 1]!.hex) : null;
            const end = entriesEnd(bytes);
            return (
              <div class="bytes__row" data-bytes-row={i}>
                <div class="bytes__meta">
                  <span class="bytes__hop">{i === 0 ? 'ingress' : `hop ${i}`}</span>
                  <span class="bytes__note">SL {h.sl}, Flags 0x{h.flags.toString(16).padStart(2, '0')}{decodeFlags(h.flags).dev ? ' (DEV)' : ''}</span>
                </div>
                <code class="bytes__hex">
                  {bytes.map((b, j) => (
                    <span
                      class:list={[
                        'b',
                        `b--${j >= end ? 'pad' : fieldOf(j)}`,
                        groupStart(j, bytes) && 'b--group',
                        prev !== null && prev[j] !== b && 'is-changed',
                      ]}
                    >{b}</span>
                  ))}
                </code>
              </div>
            );
          })}
        </div>
      </div>
      <p class="legend">
        <span class="legend__item"><span class="b b--sl">SL</span> Segments Left</span>
        <span class="legend__item"><span class="b b--flags">Flags</span> (DEV = 0x01, unit code in 0x30)</span>
        <span class="legend__item"><span class="b b--devhop">Dev Hop</span></span>
        <span class="legend__item"><span class="b b--epoch">Epoch_Base</span></span>
        <span class="legend__item"><span class="b b--entry">SID + budget entries</span></span>
        <span class="legend__item"><span class="b b--pad">00</span> Padding to a multiple of 8 bytes</span>
        <span class="legend__item"><span class="b b--entry is-changed">ab</span> Changed since the previous hop</span>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="compare-title">
    <div class="container">
      <div class="section__head">
        <p class="eyebrow">Why it matters</p>
        <h2 id="compare-title">Before and after</h2>
      </div>
      <ul class="compare" role="list">
        <li class="card compare__item">
          <span class="icon-tile compare__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 12s3.3-6 9-6c1.6 0 3 .5 4.2 1.1M21 12s-3.3 6-9 6c-1.6 0-3-.5-4.2-1.1"/><path d="M4 20 20 4"/></svg>
          </span>
          <p><strong>Hop-by-hop link-state routing (OSPF-style hellos):</strong> the slowed link answers hellos, so it stays "up" and keeps carrying traffic; nobody is told it has become slow.</p>
        </li>
        <li class="card compare__item">
          <span class="icon-tile compare__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/><path d="M7 12h3M14 12h3"/></svg>
          </span>
          <p><strong>A compact source route without time (CRH-16, RFC 9631):</strong> the packet follows the same path, but no node can tell that it is behind schedule.</p>
        </li>
        <li class="card compare__item compare__item--ours">
          <span class="icon-tile compare__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="13" r="7.5"/><path d="M12 9v4l2.5 1.5M9.5 2.5h5"/></svg>
          </span>
          <p><strong>T-CRH (ours):</strong> the same path plus one budget byte per hop. The first node after the slow link sees the miss from the packet itself, with no extra control traffic, and can switch to a fallback.</p>
        </li>
      </ul>

      <div class="callout run-result">
        <p class="callout__head">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 13.5h12M4 11V7M8 11V3.5M12 11V8.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
          In this run, and its limits
        </p>
        <dl class="stats">
          <div class="stat">
            <dt>Probes that crossed the slowed link, flagged late</dt>
            <dd class="num">{det.flagged_late}<span class="stat__of"> of {det.probes_crossing_slowed_link}</span></dd>
          </div>
          <div class="stat">
            <dt>Same probes flagged in the paired run without the fault</dt>
            <dd class="num">{det.baseline_flagged}</dd>
          </div>
          <div class="stat">
            <dt>First flag after the slow-down began</dt>
            <dd class="num">{fmt(det.first_detection_after_fault_start_ms, 1)}<span class="stat__of"> ms</span></dd>
          </div>
        </dl>
        <p>
          In this run, {det.flagged_late} of the {det.probes_crossing_slowed_link} probes that crossed the slowed link
          were flagged late, and {det.baseline_flagged} of the same probes were flagged in the paired run without
          the fault. The first flag came {fmt(det.first_detection_after_fault_start_ms, 1)} ms after the slow-down began.
          This shows a strong overload; the <a href={pageHref('experiments/e1')}>E1 experiment</a> shows the limits:
          smaller delays fit inside the deadline slack and are not detected at the registered false-alarm limit, and a
          local queue monitor detects several fault types more often.
        </p>
      </div>

      <div class="source">
        <p class="kicker">Evidence</p>
        <p>
          Source: <a href={`${REPO_URL}/blob/main/${ev.manifestPath}`}>{ev.manifestPath}</a> (commit <code>{ev.gitSha.slice(0, 7)}</code>),
          extracted by <code>{ev.tool}</code> from <code>{w.run}</code>; walk.json SHA-256 <code>{ev.walkSha.slice(0, 16)}&hellip;</code>.
          Starlink does not use T-CRH; its real routing is not public.
        </p>
      </div>
    </div>
  </section>

  <script type="application/json" id="walk-data" set:html={data}></script>
  <script>
    const el = document.getElementById('walk-data');
    const root = document.querySelector<HTMLElement>('[data-controls]');
    if (el && root) {
      const { w, pts, vw } = JSON.parse(el.textContent || '{}');
      root.hidden = false;
      const frame = document.querySelector<HTMLElement>('[data-map-frame]');
      let moved = false;
      const packet = document.querySelector('[data-packet]');
      const halo = document.querySelector('[data-packet-halo]');
      const status = document.querySelector<HTMLElement>('[data-status]');
      const rows = Array.from(document.querySelectorAll('tr[data-row]'));
      const byteRows = Array.from(document.querySelectorAll('[data-bytes-row]'));
      let hop = 0, timer = 0;
      const variant = () => (document.querySelector<HTMLInputElement>('input[name="variant"]:checked')?.value === 'nofault' ? w.nofault_run : w.fault_run);
      function show(i: number) {
        hop = i;
        const [x, y] = pts[i];
        for (const dot of [packet, halo]) {
          dot?.setAttribute('cx', String(x));
          dot?.setAttribute('cy', String(y));
        }
        const h = variant().hops[i];
        const late = h.margin_ms !== null && h.margin_ms < 0;
        packet?.classList.toggle('is-late', (h.flags & 1) === 1);
        halo?.classList.toggle('is-late', (h.flags & 1) === 1);
        rows.forEach((r, j) => r.classList.toggle('is-current', j === i));
        byteRows.forEach((r, j) => r.classList.toggle('is-current', j === i));
        // Small screens: the map scrolls sideways, so keep the packet in view.
        if (frame && frame.scrollWidth > frame.clientWidth + 1) {
          const smooth = moved && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          frame.scrollTo({ left: (x / vw) * frame.scrollWidth - frame.clientWidth / 2, behavior: smooth ? 'smooth' : 'auto' });
        }
        moved = true;
        const name = w.path[i].name;
        if (status) {
          status.textContent = i === 0
            ? `Ingress ${name}: header built, Segments Left ${h.sl}`
            : `Hop ${i}, ${name}: arrived ${h.elapsed_ms.toFixed(1)} ms, deadline ${h.deadline_ms.toFixed(1)} ms` +
              (late ? ' -> LATE, DEV set' : (h.flags & 1) ? ' (DEV already set)' : ' -> on time');
          // Styling hook only; the text above says the same thing in words.
          status.dataset['state'] = late ? 'late' : (h.flags & 1) ? 'dev' : 'ok';
        }
      }
      function step() { show((hop + 1) % pts.length); }
      root.addEventListener('click', (e) => {
        const act = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-act]')?.dataset?.['act'];
        if (act === 'step') { clearInterval(timer); step(); }
        if (act === 'reset') { clearInterval(timer); show(0); }
        if (act === 'play') {
          clearInterval(timer); show(0);
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          timer = window.setInterval(() => { if (hop >= pts.length - 1) clearInterval(timer); else step(); }, reduce ? 1500 : 900);
        }
      });
      root.addEventListener('change', () => show(hop));
      show(0);
    }
  </script>
</BaseLayout>

