---
/**
 * /methodology (owner: content): the provenance labels, what is REAL / DERIVED / MODELLED /
 * UNKNOWN in this project, sources, limitations, related work, the novelty statement, and the
 * results section (links to the corrected semester results and the course milestone; the new
 * campaign's results are still to come). No result number is copied here by hand.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LabelChip from '../components/LabelChip.astro';
import DataBadge from '../components/DataBadge.astro';
import { LABELS } from '../lib/labels';
import { pageHref } from '../lib/paths';
import { REPO_URL } from '../lib/site';
import { readLatestManifest } from '../lib/data-build';
import type { DataLabel } from '../lib/data-types';

const snapshot = await readLatestManifest();
/** CelesTrak's human-readable SupGP index (the link); the exact query URL is shown as text. */
const CELESTRAK_SUPGP_PAGE = 'https://celestrak.org/NORAD/elements/supplemental/';
const celestrakQuery = snapshot.ok ? snapshot.manifest.source_url : null;

interface InventoryRow {
  what: string;
  label: DataLabel;
  labelNote?: string;
  /** Not built yet in the current simulator: shown with a "Planned" tag. */
  planned?: boolean;
  how: string;
  note: string;
}

const inventory: InventoryRow[] = [
  {
    what: 'Starlink orbital elements',
    label: 'real',
    how: 'CelesTrak supplemental GP (SupGP) element sets for Starlink, which CelesTrak derives from ephemerides published by SpaceX. Each snapshot is pinned with the sha256 hash of the raw download.',
    note: 'Elements are a fitted orbit description, not a measured position.',
  },
  {
    what: 'Satellite positions at a given time',
    label: 'real',
    labelNote: 'SGP4 on REAL elements',
    how: 'SGP4 propagation of those elements (satellite.js on this site; the sgp4 package in the Python simulator): real physics computed by real code from real data, as the project’s shared label table records it.',
    note: 'A prediction, not tracking data: SGP4 is an approximation, and its error grows with the time since the element set’s epoch. We quote no accuracy figure, because we have not measured one for these elements. The two SGP4 implementations agree to within 10 m (tested on every build).',
  },
  {
    what: 'Speed of light',
    label: 'real',
    labelNote: 'physical constant',
    how: '299,792,458 m/s in vacuum, exact by the definition of the metre.',
    note: 'The only input of a propagation delay that is not a position.',
  },
  {
    what: 'Propagation delay of a link',
    label: 'derived',
    how: 'The distance between the two nodes, from their SGP4 positions, divided by the speed of light.',
    note: 'A delay is only as strong as the link it belongs to: the delay of a MODELLED laser link is MODELLED.',
  },
  {
    what: 'Shape of the Earth',
    label: 'real',
    labelNote: 'public standard',
    how: 'The WGS84 ellipsoid, the reference shape that GPS uses.',
    note: 'Used for altitudes and ground positions on this site, and for the line-of-sight rule below.',
  },
  {
    what: 'Line of sight between two nodes',
    label: 'modelled',
    labelNote: '80 km clearance',
    how: 'A laser link is allowed only while the straight line between the two satellites stays at least 80 km above the WGS84 ellipsoid, to keep it clear of the atmosphere. The geometry is exact, but the 80 km clearance is our choice (Hypatia’s rule), so the rule as a whole is MODELLED.',
    note: 'Applied by the Python topology code at every time step and by this site’s route planner at the instant you pick.',
  },
  {
    what: 'T-CRH header bytes',
    label: 'real',
    labelNote: 'defined by our code',
    how: 'The exact bytes our encoder produces, pinned byte for byte by the golden test vectors in spec/golden/.',
    note: 'This site’s TypeScript engine is checked against every vector when the site is built (see the protocol page). The Python reference has a golden-vector test that runs in the project’s continuous integration. The ns-3 module has a test suite for the same vectors (make ns3-test), which is run locally, not in continuous integration.',
  },
  {
    what: 'Orbital shells (colour groups)',
    label: 'derived',
    how: 'Grouped by our code from each element set’s inclination and mean altitude. The globes colour the satellites by these groups.',
    note: 'A grouping for display, not SpaceX’s own shell assignment. Public fleet statistics, such as Jonathan McDowell’s, are an independent reference.',
  },
  {
    what: 'Orbital planes',
    label: 'derived',
    how: 'Inferred by our pipeline from the elements: satellites are grouped into shells by inclination and altitude, and into planes by their ascending node; within a plane they are ordered by argument of latitude.',
    note: 'SpaceX does not publish its planes. Satellites that fit no plane are left out of routing, and the route planner says how many.',
  },
  {
    what: 'Laser inter-satellite link topology',
    label: 'modelled',
    how: 'Grid-4 (also written +Grid), a common research assumption, on those inferred planes. Each satellite links to the satellites ahead of and behind it in its plane and to at most one satellite in each neighbouring plane (a one-to-one nearest match). Links between planes are off above 70° latitude.',
    note: 'Four links per satellite is an assumption from the research literature (Hypatia, after SpaceX regulatory filings), not knowledge of today’s network. Which satellites Starlink links, and how often those links change, is not public.',
  },
  {
    what: 'Ground links',
    label: 'modelled',
    labelNote: '25° mask assumed',
    how: 'A city sees a satellite at least 25° above its horizon and connects to the four highest. The 25° value is from Starlink’s regulatory filings, as used by Hypatia; which visible satellites a terminal really uses is not public.',
    note: 'Cities are placed on the WGS84 ellipsoid from Natural Earth coordinates (REAL).',
  },
  {
    what: 'Processing delay per hop',
    label: 'modelled',
    how: '0.5 ms added to the light time of every hop when routes are planned.',
    note: 'The existing model’s value; not measured on a real satellite.',
  },
  {
    what: 'Link capacities and queues',
    label: 'modelled',
    how: 'Chosen per experiment and stated with it.',
    note: 'Not public for Starlink.',
  },
  {
    what: 'Traffic',
    label: 'modelled',
    how: 'Who sends how much to whom, and when: chosen per experiment and stated with it.',
    note: 'Not public for Starlink.',
  },
  {
    what: 'Failures and slowdowns',
    label: 'modelled',
    how: 'Which links go down or become slow, when, and for how long: chosen per experiment and stated with it.',
    note: 'The up-but-slow case is the one T-CRH is designed to catch.',
  },
  {
    what: 'Starlink’s real routing',
    label: 'unknown',
    how: 'Not public.',
    note: 'We never claim it. Starlink does not use T-CRH; its public orbits serve only as a realistic test geometry.',
  },
];

interface Source {
  title: string;
  href: string;
  detail: string;
  /** Shown verbatim as code under the detail (e.g. the exact download URL). */
  code?: { label: string; text: string };
}

const sources: Source[] = [
  {
    title: 'CelesTrak: supplemental GP element sets',
    href: CELESTRAK_SUPGP_PAGE,
    detail: 'The orbit data. Orbit data courtesy of CelesTrak (celestrak.org); SupGP elements derived from SpaceX ephemerides.',
