---
/**
 * Site header: wordmark and primary navigation. On narrow screens the navigation
 * collapses behind a menu button (only when JavaScript runs; without it the links stay
 * visible and wrap).
 */
import { NAV_ITEMS, SITE_NAME } from '../lib/site';
import { isCurrentPage, pageHref } from '../lib/paths';

const current = Astro.url.pathname;
const items = NAV_ITEMS.map((item) => {
  const href = pageHref(item.path);
  return { ...item, href, active: isCurrentPage(current, href) };
});
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href={pageHref('')} aria-label={`${SITE_NAME}, home`}>
      <span class="wordmark__badge" aria-hidden="true">
        <svg class="wordmark__mark" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false">
          <circle cx="16" cy="16" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <ellipse cx="16" cy="16" rx="14" ry="6" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.55" transform="rotate(-28 16 16)"></ellipse>
          <circle cx="27.6" cy="9.6" r="2.4" class="wordmark__dot"></circle>
        </svg>
      </span>
      <span class="wordmark__text">{SITE_NAME}</span>
    </a>

    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-button
    >
      <span class="menu-button__icon" aria-hidden="true"></span>
      <span>Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main" data-menu>
      <ul class="site-nav__list">
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={item.active ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (button && menu) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      menu.dataset['open'] = String(open);
    };
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
    // Keep in step with the breakpoint in the styles below.
    window.matchMedia('(min-width: 72em)').addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Opaque on purpose: a translucent header let page text show through while scrolling
       (the CSS minifier kept only the -webkit- blur, which Chrome ignores). */
    background: linear-gradient(180deg, var(--bg-deep), var(--bg));
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.9);
  }

  /* Hairline under the header, brightest in the middle. */
  .site-header::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(90deg, var(--line-soft), rgb(122 174 255 / 0.4) 50%, var(--line-soft));
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
    flex-wrap: wrap;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink);
    text-decoration: none;
    padding-block: var(--space-2);
  }

  .wordmark__badge {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-2);
    border: 1px solid var(--line-strong);
    background: radial-gradient(circle at 30% 25%, var(--surface-3), var(--surface) 70%);
    box-shadow: var(--highlight-top), 0 0 18px -6px rgb(122 174 255 / 0.5);
    transition: box-shadow var(--dur-slow) var(--ease), border-color var(--dur) var(--ease);
  }

  .wordmark:hover .wordmark__badge {
    border-color: var(--accent-line);
    box-shadow: var(--highlight-top), 0 0 22px -4px rgb(122 174 255 / 0.65);
  }

  .wordmark__mark {
    color: var(--accent);
    flex: none;
  }

  .wordmark__dot {
    fill: var(--deadline);
  }

  .wordmark__text {
    font-family: var(--font-display);
    font-weight: 660;
    font-stretch: var(--stretch-wide);
    font-size: 1.125rem;
    letter-spacing: 0.01em;
  }

  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .site-nav__list li + li {
    margin-top: 0;
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding-inline: 0.7rem;
    border: 1px solid transparent;
    border-radius: var(--radius-2);
    color: var(--muted);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .site-nav a:hover {
    color: var(--ink);
    background: var(--surface);
  }

  /* Active page: raised pill plus an accent bar (shape and position, not colour alone). */
  .site-nav a[aria-current='page'] {
    color: var(--ink);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border-color: var(--line-strong);
    box-shadow: var(--highlight-top);
  }

  .site-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -1px;
    width: 1.5rem;
    height: 2px;
    border-radius: 2px;
    transform: translateX(-50%);
    background: var(--accent);
    box-shadow: 0 0 10px 1px rgb(122 174 255 / 0.6);
  }

  .menu-button {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-2);
    box-shadow: var(--highlight-top);
    cursor: pointer;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .menu-button:hover {
    border-color: var(--accent);
  }

  .menu-button__icon,
  .menu-button__icon::before,
  .menu-button__icon::after {
    display: block;
    width: 16px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: transform var(--dur) var(--ease);
  }

  .menu-button__icon {
    position: relative;
  }

  .menu-button__icon::before,
  .menu-button__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .menu-button__icon::before {
    top: -5px;
  }

  .menu-button__icon::after {
    top: 5px;
  }

  .menu-button[aria-expanded='true'] .menu-button__icon {
    background: transparent;
  }

  .menu-button[aria-expanded='true'] .menu-button__icon::before {
    transform: translateY(5px) rotate(45deg);
  }

  .menu-button[aria-expanded='true'] .menu-button__icon::after {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* Narrow screens with JavaScript: collapsible menu (below 72em, where the eight links no
     longer fit on one row next to the wordmark). Without JavaScript: links wrap. */
  @media (max-width: 71.99em) {
    :global(.js) .menu-button {
      display: inline-flex;
    }

    :global(.js) .site-nav {
      display: none;
      width: 100%;
      padding-bottom: var(--space-4);
    }

    :global(.js) .site-nav[data-open='true'] {
      display: block;
      animation: menu-in var(--dur-slow) var(--ease);
    }

    :global(.js) .site-nav__list {
      display: grid;
      gap: var(--space-1);
      padding: var(--space-2);
      border: 1px solid var(--line);
      border-radius: var(--radius-3);
      background: var(--panel-sheen), var(--surface);
      box-shadow: var(--shadow-2);
    }

    :global(.js) .site-nav a {
      display: flex;
      justify-content: space-between;
      min-height: 2.75rem;
      padding-inline: var(--space-4);
      font-size: var(--step-0);
    }

    /* A chevron on each row says "go there". */
    :global(.js) .site-nav a::before {
      content: '';
      order: 2;
      width: 0.45rem;
      height: 0.45rem;
      border-top: 1.5px solid currentColor;
      border-right: 1.5px solid currentColor;
      transform: rotate(45deg);
      opacity: 0.55;
    }

    :global(.js) .site-nav a[aria-current='page'] {
      background: var(--surface-2);
    }

    :global(.js) .site-nav a[aria-current='page']::after {
      left: -1px;
      top: 50%;
      bottom: auto;
      width: 3px;
      height: 1.4rem;
      transform: translateY(-50%);
    }
  }

  @media (min-width: 30em) and (max-width: 71.99em) {
    :global(.js) .site-nav__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Without JavaScript the links wrap; keep them compact on phones. */
  @media (max-width: 40em) {
    .site-nav a {
      padding-inline: 0.55rem;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
