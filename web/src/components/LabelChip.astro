---
/**
 * Provenance chip: REAL, DERIVED, MODELLED or UNKNOWN. Each kind has its own colour AND
 * its own shape, so the label never depends on colour alone.
 *   REAL      filled circle
 *   DERIVED   filled diamond
 *   MODELLED  hollow square
 *   UNKNOWN   dashed ring
 * Usage: <LabelChip kind="derived" note="SGP4 from CelesTrak elements" />
 */
import type { DataLabel } from '../lib/data-types';
import { labelInfo } from '../lib/labels';

interface Props {
  kind: DataLabel;
  /** Optional short note shown after the label, e.g. what the value was derived from. */
  note?: string;
  size?: 'sm' | 'md';
}

const { kind, note, size = 'md' } = Astro.props;
const info = labelInfo(kind);
---

<span class:list={['chip', `chip--${kind}`, `chip--${size}`]} title={info.definition}>
  <svg class="chip__mark" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true" focusable="false">
    {kind === 'real' && <circle cx="5" cy="5" r="4" fill="currentColor" />}
    {kind === 'derived' && <path d="M5 0.6 9.4 5 5 9.4 0.6 5Z" fill="currentColor" />}
    {kind === 'modelled' && <rect x="1.25" y="1.25" width="7.5" height="7.5" fill="none" stroke="currentColor" stroke-width="1.5" />}
    {kind === 'unknown' && <circle cx="5" cy="5" r="3.6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2 1.6" />}
  </svg>
  <span class="chip__name"><span class="sr-only">Label: </span>{info.name}</span>
  {note && <span class="chip__note">{note}</span>}
</span>

<style>
  .chip {
    --chip-color: var(--unknown);
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    max-width: 100%;
    padding: 0.2em 0.6em 0.2em 0.5em;
    border: 1px solid color-mix(in srgb, var(--chip-color) 45%, transparent);
    background: color-mix(in srgb, var(--chip-color) 10%, transparent);
    border-radius: var(--radius-1);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: 1.4;
    color: var(--ink);
    vertical-align: middle;
  }

  .chip--sm {
    font-size: 0.6875rem;
  }

  .chip--real {
    --chip-color: var(--real);
  }

  .chip--derived {
    --chip-color: var(--derived);
  }

  .chip--modelled {
    --chip-color: var(--modelled);
  }

  .chip--unknown {
    --chip-color: var(--unknown);
  }

  .chip__mark {
    width: 0.8em;
    height: 0.8em;
    flex: none;
    color: var(--chip-color);
  }

  .chip__name {
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--chip-color);
    white-space: nowrap;
  }

  .chip__note {
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  @media (forced-colors: active) {
    .chip {
      border-color: CanvasText;
    }
  }
</style>
