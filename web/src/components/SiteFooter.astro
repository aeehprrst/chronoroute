---
/**
 * Site footer: project facts, data attribution, the non-affiliation statement, licence
 * and repository link. Attribution text comes from the snapshot manifest when present.
 */
import { NAV_ITEMS, LICENCE_SHORT, LICENCE_URL, REPO_URL, SITE_NAME, SITE_TAGLINE } from '../lib/site';
import { pageHref } from '../lib/paths';
import { readLatestManifest } from '../lib/data-build';

const DEFAULT_ATTRIBUTION =
  'Orbit data courtesy of CelesTrak (celestrak.org); SupGP elements derived from SpaceX ephemerides.';
interface Props { evidenceOnly?: boolean; }
const snapshot = Astro.props.evidenceOnly ? null : await readLatestManifest();
const attribution = snapshot?.ok ? snapshot.manifest.attribution : DEFAULT_ATTRIBUTION;
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <section class="site-footer__col site-footer__brand" aria-labelledby="footer-project">
        <h2 id="footer-project" class="site-footer__name">
          <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true" focusable="false">
            <circle cx="16" cy="16" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <ellipse cx="16" cy="16" rx="14" ry="6" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.55" transform="rotate(-28 16 16)"></ellipse>
            <circle cx="27.6" cy="9.6" r="2.4" class="site-footer__dot"></circle>
          </svg>
          {SITE_NAME}
        </h2>
        <p>{SITE_TAGLINE}. A student project for the Computer Networks course at VIT Vellore.</p>
        <p class="site-footer__links-inline">
          <a href={REPO_URL} rel="noopener">Source code on GitHub</a>
          <span aria-hidden="true"> · </span>
          <a href={LICENCE_URL} rel="noopener">Licence</a>: {LICENCE_SHORT}
        </p>
      </section>

      <section class="site-footer__col" aria-labelledby="footer-data">
        <h2 id="footer-data" class="site-footer__title">Data</h2>
        <p>{attribution}</p>
        <p>
          Every number and visual on this site carries a label: REAL, DERIVED, MODELLED or UNKNOWN.
          <a href={pageHref('methodology#labels')}>What the labels mean</a>
        </p>
      </section>

      <section class="site-footer__col site-footer__notice" aria-labelledby="footer-notice">
        <h2 id="footer-notice" class="site-footer__title">Notice</h2>
        <p>
          <strong>Not affiliated with SpaceX.</strong> This project is not affiliated with,
          endorsed by or connected to SpaceX or Starlink. Starlink does not use T-CRH; we use
          public Starlink orbits only as realistic test geometry.
        </p>
        <p class="site-footer__privacy">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
            <path d="M8 1.5 2.75 3.5v4c0 3.1 2.2 5.6 5.25 7 3.05-1.4 5.25-3.9 5.25-7v-4L8 1.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
          </svg>
          No analytics, no cookies, no third-party requests.
        </p>
      </section>

      <nav class="site-footer__col" aria-label="Footer">
        <h2 class="site-footer__title">Pages</h2>
        <ul class="site-footer__links">
          {NAV_ITEMS.map((item) => (
            <li><a href={pageHref(item.path)}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: var(--space-9);
    background:
      radial-gradient(50rem 16rem at 15% 0%, rgb(122 174 255 / 0.06), transparent 70%),
      linear-gradient(180deg, var(--surface), var(--bg-deep));
    padding-block: var(--space-7) var(--space-8);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, var(--line-soft), rgb(122 174 255 / 0.35) 50%, var(--line-soft));
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 40em) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .site-footer__grid {
      grid-template-columns: 1.15fr 1.1fr 1.2fr 0.75fr;
      gap: var(--space-7);
    }
  }

  .site-footer__col > * + * {
    margin-top: var(--space-3);
  }

  .site-footer__name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 660;
    font-stretch: var(--stretch-wide);
    letter-spacing: 0.01em;
    color: var(--ink);
  }

  .site-footer__name svg {
    color: var(--accent);
  }

  .site-footer__dot {
    fill: var(--deadline);
  }

  .site-footer__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    font-stretch: 100%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line);
  }

  .site-footer strong {
    color: var(--ink);
  }

  .site-footer__privacy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-2);
    background: var(--bg-deep);
    color: var(--ink-2);
  }

  .site-footer__privacy svg {
    flex: none;
    color: var(--accent);
  }

  .site-footer__links {
    list-style: none;
    padding: 0;
  }

  @media (max-width: 63.99em) {
    .site-footer__links {
      columns: 2;
    }
  }

  .site-footer__links li {
    break-inside: avoid;
  }

  .site-footer__links li + li {
    margin-top: var(--space-1);
  }

  .site-footer__links a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--ink-2);
    text-decoration: none;
  }

  .site-footer__links a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
