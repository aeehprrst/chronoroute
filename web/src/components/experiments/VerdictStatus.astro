---
/**
 * Verdict status badge for an experiment: the status computed by verdict() in
 * lib/experiments/data.ts, in words and with its own icon shape (never colour alone).
 *   supported      ring with a tick
 *   mixed          half-filled ring
 *   not supported  ring with a cross
 *   unestablished / incomplete   dashed ring
 * The full verdict sentence must always be shown next to it.
 */
import type { VerdictStatus } from '../../lib/experiments/data';

interface Props {
  status: VerdictStatus;
}

const { status } = Astro.props;
const words: Record<VerdictStatus, string> = {
  supported: 'Supported',
  'not supported': 'Not supported',
  mixed: 'Mixed',
  unestablished: 'Unestablished',
  incomplete: 'Incomplete',
};
const modifier = status.replace(' ', '-');
---

<span class:list={["status-badge", `status-badge--${modifier}`]}>
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    {status === 'supported' && (
      <>
        <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="m5.2 8.2 1.9 1.9 3.8-4.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </>
    )}
    {status === 'mixed' && (
      <>
        <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M8 1.6a6.4 6.4 0 0 1 0 12.8Z" fill="currentColor" />
      </>
    )}
    {status === 'not supported' && (
      <>
        <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="m5.6 5.6 4.8 4.8m0-4.8-4.8 4.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </>
    )}
    {(status === 'unestablished' || status === 'incomplete') && (
      <circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.4 2" />
    )}
  </svg>
  <span><span class="sr-only">Verdict status: </span>{words[status]}</span>
</span>
