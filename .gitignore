# Python virtual environment
# (recreate with: python3 -m venv venv && venv/bin/pip install -e ".[test]")
venv/
.venv/
__pycache__/
*.pyc
*.pyo

# Packaging / build artefacts (pip install -e writes sim/chronoroute.egg-info/)
*.egg-info/
.eggs/
/build/
/dist/

# Test and tool caches
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Scratch files and editor/OS junk (team scratch space is /tmp/cr-p1/, outside the repo)
/tmp/
*.tmp
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
.ipynb_checkpoints/

# Deliberately NOT ignored -- these are tracked evidence:
#   results/       experiment outputs + manifest.json (aggregates only)
#   data/pinned/   frozen orbit snapshots used by experiments (never edit)
#   spec/golden/   golden vectors, checked by `make golden`
