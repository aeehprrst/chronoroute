# ChronoRoute -- common tasks. Run from the repository root inside WSL:
#
#     make test          # pytest (sim/tests)
#     make check         # pytest + golden-vector reproducibility check
#
# Variables can be overridden on the command line, e.g. in CI (no venv there):
#     make test PYTHON=python

SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c
.DEFAULT_GOAL := help
# Targets share files (golden vectors, results/), so never run them in parallel.
.NOTPARALLEL:

# Absolute path, because some targets cd into sim/legacy before running Python.
PYTHON   ?= $(CURDIR)/venv/bin/python
# -B: never write __pycache__ next to the sources.
PY       := $(PYTHON) -B
NS3_DIR  ?= $(HOME)/ns-3-dev
# WSL has only 7.6 GiB of RAM; more than 8 parallel C++ jobs runs it out of memory.
NS3_JOBS ?= 8
# ns-3 test suite(s) to run; a space-separated list is allowed.
NS3_SUITES ?= chronoroute

export PYTHONDONTWRITEBYTECODE := 1
# Plots are written to files; never try to open a window.
export MPLBACKEND := Agg

# Extra options for tools/ns3-sync.sh, e.g. make ns3-sync ARGS=--copy
ARGS ?=

.PHONY: help test legacy-dev legacy-starlink golden ns3-sync ns3-test ns3-legacy course-milestone check

help:  ## List the targets
	@grep -E '^[a-z0-9-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  make %-16s %s\n", $$1, $$2}'

test:  ## Run the Python test suite (pytest, sim/tests)
	$(PY) -m pytest

legacy-dev:  ## Re-run legacy experiments 1-5 on the 480-satellite dev shell
	cd sim/legacy && $(PY) run_all.py

legacy-starlink:  ## Re-run legacy experiments 1-7 on the 1584-satellite Starlink Shell-1 preset
	cd sim/legacy && $(PY) run_scaled.py starlink

golden:  ## Regenerate spec/golden, fail if anything changed versus git or the ns-3 .inc is stale
	@test -f spec/golden/gen_vectors.py || { echo "spec/golden/gen_vectors.py not found" >&2; exit 1; }
	$(PY) spec/golden/gen_vectors.py
	@# The ns-3 test suite compiles the vectors in from a generated .inc; a stale
	@# .inc would keep CI green while ns-3 checks old vectors. Pure Python, no ns-3 needed.
	$(PY) tools/golden_to_inc.py --check
	@# Tracked files: the regenerated bytes must equal what is committed (or staged).
	@git diff --exit-code --stat -- spec/golden || { \
		echo "golden vectors changed when regenerated: review 'git diff spec/golden', then commit or fix the generator" >&2; \
		exit 1; }
	@# New files the generator wrote that git does not know about also count as a change.
	@untracked="$$(git ls-files --others --exclude-standard -- spec/golden)"; \
	if [ -n "$$untracked" ]; then \
		echo "golden: untracked files in spec/golden (git add them, or stop generating them):" >&2; \
		echo "$$untracked" >&2; \
		exit 1; \
	fi
	@echo "golden: spec/golden is reproducible"

ns3-sync:  ## Symlink (or copy, with ARGS=--copy) the ns-3 module and scratch programs into the ns-3 tree
	@if [ -x tools/ns3-sync.sh ]; then \
		NS3_DIR="$(NS3_DIR)" tools/ns3-sync.sh $(ARGS); \
	elif [ -f tools/ns3-sync.sh ]; then \
		NS3_DIR="$(NS3_DIR)" bash tools/ns3-sync.sh $(ARGS); \
	else \
		echo "ns3-sync: tools/ns3-sync.sh not present, nothing to sync"; \
	fi

ns3-test: ns3-sync  ## Build ns-3 (at most NS3_JOBS jobs) and run the chronoroute test suite(s)
	@test -x "$(NS3_DIR)/ns3" || { echo "ns-3 not found at NS3_DIR=$(NS3_DIR)" >&2; exit 1; }
	cd "$(NS3_DIR)" && ./ns3 build -j$(NS3_JOBS)
	cd "$(NS3_DIR)" && for suite in $(NS3_SUITES); do ./test.py --no-build --suite "$$suite"; done

ns3-legacy: ns3-sync  ## Re-run the legacy ns-3 T-CRH slack sweep into results/legacy-v0.9/ns3/tcrh_sweep
	cd "$(NS3_DIR)" && ./ns3 build -j$(NS3_JOBS) scratch/tcrh-experiment scratch/tcrh-experiment-a8
	NS3_DIR="$(NS3_DIR)" $(PY) ns3/run_tcrh_sweep.py

course-milestone: ns3-sync  ## Course milestone: ns-3 LEO run on the real 463 km shell (rebuilds bundles from git-recorded recipes)
	$(PY) ns3/run_leo.py --recipe c5-463-10s-small
	$(PY) ns3/run_leo.py --recipe c5-463-60s --no-build

check:  ## Everything CI checks: test + golden (golden includes the ns-3 .inc check)
	$(MAKE) test
	$(MAKE) golden
